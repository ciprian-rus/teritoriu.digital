{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teritoriu.digital/schemas/territory-geometries/1.0.0",
  "title": "Geometrii teritoriale",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "license", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "name", "url", "attribution"],
      "properties": {
        "spdx": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "attribution": { "type": "string", "minLength": 1 }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "geometry", "properties"],
        "properties": {
          "type": { "const": "Feature" },
          "geometry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "coordinates"],
            "properties": {
              "type": { "type": "string", "enum": ["Polygon", "MultiPolygon"] },
              "coordinates": { "type": "array", "minItems": 1 }
            }
          },
          "properties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["territoryId", "geometryKind", "detailLevel", "sourceSnapshotId"],
            "properties": {
              "territoryId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "geometryKind": { "type": "string", "enum": ["source", "derived", "simplified"] },
              "detailLevel": { "type": "string", "enum": ["original", "high", "medium", "low"] },
              "sourceSnapshotId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "sourceFeatureKey": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
